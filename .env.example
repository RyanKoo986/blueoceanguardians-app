# ==============================================================================
# Environment Configuration Template for Blue Ocean Guardians
# Copy this file to '.env' or '.env.local' in this directory.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project URL
# ------------------------------------------------------------------------------
# [Acquisition Guide]
# Step 1: Open https://supabase.com/dashboard and log into your account.
# Step 2: Select your project (or click 'New Project' to create one).
# Step 3: In the left sidebar navigation, click on the 'Project Settings' (Gear icon).
# Step 4: Under the Settings submenu, click on 'API' (Configuration -> API).
# Step 5: Under 'Project URL', copy the 'URL' value (e.g., https://xyzcompany.supabase.co).
# Role/Permission: Project Member or Owner
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# ------------------------------------------------------------------------------
# 2. Supabase Anonymous Public API Key
# ------------------------------------------------------------------------------
# [Acquisition Guide]
# Step 1: Open https://supabase.com/dashboard and select your project.
# Step 2: Click 'Project Settings' (Gear icon in left sidebar) -> 'API'.
# Step 3: Under 'Project API keys', locate the key with the 'anon' / 'public' label.
# Step 4: Click the 'Copy' button beside the anon public key.
# Note: Do NOT use the service_role key on the client/frontend.
# Role/Permission: Project Member or Owner
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. Supabase Custom Database Schema
# ------------------------------------------------------------------------------
# The custom PostgreSQL schema name defined in schema.sql
VITE_SUPABASE_SCHEMA=dokdo_guardians

# ------------------------------------------------------------------------------
# 4. Supabase Storage Bucket for Uploads
# ------------------------------------------------------------------------------
# [Acquisition Guide]
# Step 1: In Supabase dashboard, click 'Storage' in the left menu.
# Step 2: Click 'New bucket' and name it 'guardians-storage'.
# Step 3: Toggle 'Public bucket' to ON (allows public read access to uploaded images/files).
# Step 4: Click 'Save bucket'.
VITE_SUPABASE_STORAGE_BUCKET=guardians-storage

# ------------------------------------------------------------------------------
# 5. OpenAI API Key (for GPT-4o AI Fact-Check & Text Refinement)
# ------------------------------------------------------------------------------
# [Acquisition Guide]
# Step 1: Open https://platform.openai.com and log in.
# Step 2: In the left sidebar, navigate to 'API keys' (under Dashboard / Organization).
# Step 3: Click '+ Create new secret key', enter a name (e.g., 'BlueOceanGuardians').
# Step 4: Copy the secret key (starts with sk-proj-...) and paste it below.
# Note: If left empty, the app runs with a smart local mock engine for offline testing.
# Role/Permission: OpenAI Account with active billing or API credits
VITE_OPENAI_API_KEY=your-openai-api-key-here

